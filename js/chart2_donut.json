{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 520,
  "height": 330,

  "data": {
    "url": "data/threatened_species.csv"
  },

  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "species_count"
        }
      ],
      "groupby": ["status"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "species_count",
          "as": "total_count"
        }
      ]
    },
    {
      "calculate": "datum.species_count / datum.total_count",
      "as": "percentage"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 75,
        "outerRadius": 140,
        "stroke": "#1a2a3a",
        "strokeWidth": 2
      },

      "encoding": {
        "theta": {
          "field": "species_count",
          "type": "quantitative"
        },

        "color": {
          "field": "status",
          "type": "nominal",
          "title": "Conservation Status",

          "scale": {
            "domain": [
              "Critically Endangered",
              "Endangered",
              "Vulnerable",
              "Near Threatened",
              "Extinct"
            ],
            "range": [
              "#c0392b",
              "#e67e22",
              "#f39c12",
              "#2ecc71",
              "#8e44ad"
            ]
          },

          "legend": {
            "orient": "right",
            "labelColor": "#e8e0d0",
            "titleColor": "#f39c12",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 120
          }
        },

        "tooltip": [
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Number of Species"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Percentage",
            "format": ".1%"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "radius": 110,
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#0d1b2a"
      },

      "encoding": {
        "theta": {
          "field": "species_count",
          "type": "quantitative"
        },

        "text": {
          "field": "species_count",
          "type": "quantitative"
        }
      }
    }
  ],

  "config": {
    "background": "#1a2a3a",
    "view": {
      "stroke": null
    }
  }
}