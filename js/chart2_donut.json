{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Distribution of threatened species by conservation status.",
    "color": "#f39c12",
    "subtitle": "Hover over a segment to highlight it.",
    "subtitleColor": "#aab7b8",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "anchor": "start"
  },

  "width": 520,
  "height": 330,
  "background": "#1a2a3a",

  "data": {
    "url": "data/threatened_species.csv"
  },

  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "species_count"
        }
      ],
      "groupby": ["status"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "species_count",
          "as": "total_count"
        }
      ]
    },
    {
      "calculate": "datum.species_count / datum.total_count",
      "as": "percentage"
    },
    {
      "calculate": "datum.status == 'Critically Endangered' ? 1 : datum.status == 'Endangered' ? 2 : datum.status == 'Vulnerable' ? 3 : datum.status == 'Near Threatened' ? 4 : 5",
      "as": "status_order"
    }
  ],

  

  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 75,
        "outerRadius": 140,
        "stroke": "#1a2a3a",
        "strokeWidth": 2
      },

      "encoding": {
        "theta": {
          "field": "species_count",
          "type": "quantitative",
          "stack": true
        },

        "order": {
          "field": "status_order",
          "type": "quantitative",
          "sort": "ascending"
        },

        "color": {
          "field": "status",
          "type": "nominal",
          "title": "Conservation Status",
          "scale": {
            "domain": [
              "Critically Endangered",
              "Endangered",
              "Vulnerable",
              "Near Threatened",
              "Extinct"
            ],
            "range": [
              "#c0392b",
              "#e67e22",
              "#f39c12",
              "#2ecc71",
              "#8e44ad"
            ]
          },
          "legend": {
            "orient": "right",
            "labelColor": "#e8e0d0",
            "titleColor": "#f39c12",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 120
          }
        },

        

        "tooltip": [
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Number of Species"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Percentage",
            "format": ".1%"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "radius": 112,
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#ffffff"
      },

      "encoding": {
        "theta": {
          "field": "species_count",
          "type": "quantitative",
          "stack": true
        },

        "order": {
          "field": "status_order",
          "type": "quantitative"
        },

        "text": {
          "field": "species_count",
          "type": "quantitative"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "font": "Georgia"
  }
}