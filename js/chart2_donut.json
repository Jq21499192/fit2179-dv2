{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 430,
  "data": {
    "url": "data/threatened_species.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "species_count"
        }
      ],
      "groupby": ["status"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "species_count",
          "as": "total_count"
        }
      ]
    },
    {
      "calculate": "datum.species_count / datum.total_count",
      "as": "percentage"
    },
    {
      "calculate": "datum.species_count + ' (' + format(datum.percentage, '.1%') + ')'",
      "as": "label"
    }
  ],
  "params": [
    {
      "name": "status_hover",
      "select": {
        "type": "point",
        "fields": ["status"],
        "on": "mouseover",
        "clear": "mouseout"
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 100,
        "outerRadius": 175,
        "stroke": "#132434",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "species_count",
          "type": "quantitative"
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Critically Endangered",
              "Endangered",
              "Vulnerable",
              "Not Threatened",
              "Extinct"
            ],
            "range": [
              "#c0392b",
              "#e67e22",
              "#f1c40f",
              "#2ecc71",
              "#8e44ad"
            ]
          },
          "legend": {
            "title": "Status",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "labelColor": "#e8e0d0",
            "titleColor": "#f39c12",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 120
          }
        },
        "opacity": {
          "condition": {
            "param": "status_hover",
            "value": 1,
            "empty": true
          },
          "value": 0.35
        },
        "tooltip": [
          {
            "field": "status",
            "type": "nominal",
            "title": "Status"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Number of Species"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Percentage",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 220,
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#e8e0d0"
      },
      "encoding": {
        "theta": {
          "field": "species_count",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#1a2a3a",
    "view": {
      "stroke": null
    }
  }
}