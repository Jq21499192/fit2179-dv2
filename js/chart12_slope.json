{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bushfire Area by State: 2009 vs 2019",
    "subtitle": "How fire-affected area changed between two major fire years",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 400,
  "data": { "url": "data/bushfire.csv" },
  "transform": [
    { "filter": "datum.year == 2009 || datum.year == 2019" },
    { "calculate": "toString(datum.year)", "as": "year_str" }
  ],
  "layer": [
    {
      "mark": { "type": "line", "strokeWidth": 2, "opacity": 0.7 },
      "encoding": {
        "x": {
          "field": "year_str",
          "type": "ordinal",
          "sort": ["2009", "2019"],
          "title": "Year",
          "axis": {
            "labelColor": "#e8e0d0",
            "titleColor": "#bdc3c7",
            "labelFontSize": 13,
            "domainColor": "#bdc3c7",
            "tickColor": "#bdc3c7"
          }
        },
        "y": {
          "field": "area_hectares",
          "type": "quantitative",
          "title": "Area Burned (hectares)",
          "axis": {
            "labelColor": "#bdc3c7",
            "titleColor": "#bdc3c7",
            "gridColor": "#2c3e50",
            "format": "~s"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "range": ["#c0392b","#e67e22","#f39c12","#27ae60","#2980b9","#8e44ad","#16a085","#d35400"]
          },
          "legend": {
            "title": "State",
            "labelColor": "#e8e0d0",
            "titleColor": "#bdc3c7"
          }
        },
        "detail": { "field": "state", "type": "nominal" }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 80 },
      "encoding": {
        "x": { "field": "year_str", "type": "ordinal", "sort": ["2009", "2019"] },
        "y": { "field": "area_hectares", "type": "quantitative" },
        "color": { "field": "state", "type": "nominal" },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "year_str", "type": "nominal", "title": "Year" },
          { "field": "area_hectares", "type": "quantitative", "title": "Area (ha)", "format": "," }
        ]
      }
    },
    {
      "transform": [
        { "filter": "datum.year == 2009" }
      ],
      "mark": { "type": "text", "align": "right", "dx": -8, "fontSize": 10 },
      "encoding": {
        "x": { "field": "year_str", "type": "ordinal", "sort": ["2009", "2019"] },
        "y": { "field": "area_hectares", "type": "quantitative" },
        "text": { "field": "state", "type": "nominal" },
        "color": { "field": "state", "type": "nominal" }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" }
  }
}