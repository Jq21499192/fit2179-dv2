{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Total Wildlife Casualties by State",
    "subtitle": "Estimated animals killed (millions) across all recorded bushfires",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 320,
  "data": { "url": "data/bushfire.csv" },
  "transform": [
    {
      "aggregate": [{ "op": "sum", "field": "animals_killed_million", "as": "total_animals" }],
      "groupby": ["state"]
    }
  ],
  "mark": { "type": "bar", "cornerRadiusEnd": 4 },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": { "labelColor": "#e8e0d0", "labelFontSize": 12 }
    },
    "x": {
      "field": "total_animals",
      "type": "quantitative",
      "title": "Animals Killed (millions)",
      "axis": { "labelColor": "#bdc3c7", "titleColor": "#bdc3c7", "gridColor": "#2c3e50" }
    },
    "color": {
      "field": "total_animals",
      "type": "quantitative",
      "scale": { "scheme": "orangered" },
      "legend": null
    },
    "tooltip": [
      { "field": "state", "type": "nominal", "title": "State" },
      { "field": "total_animals", "type": "quantitative", "title": "Animals Killed (M)", "format": ".1f" }
    ]
  },
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" }
  }
}
