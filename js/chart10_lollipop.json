{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Threatened Species by Animal Class",
    "subtitle": "This radial chart shows which animal classes contribute most to the threatened species list",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/threatened_species.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "distinct",
          "field": "common_name",
          "as": "species_count"
        }
      ],
      "groupby": ["class"]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "species_count",
          "as": "max_count"
        }
      ]
    },
    {
      "calculate": "datum.species_count / datum.max_count",
      "as": "normalised_count"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 45,
        "stroke": "#1a2a3a",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "class",
          "type": "nominal",
          "sort": {
            "field": "species_count",
            "order": "descending"
          }
        },
        "radius": {
          "field": "species_count",
          "type": "quantitative",
          "scale": {
            "range": [80, 190]
          }
        },
        "color": {
          "field": "class",
          "type": "nominal",
          "scale": {
            "range": [
              "#c0392b",
              "#e67e22",
              "#f1c40f",
              "#2ecc71",
              "#8e44ad",
              "#3498db"
            ]
          },
          "legend": {
            "title": "Animal Class",
            "orient": "right",
            "labelColor": "#e8e0d0",
            "titleColor": "#f39c12",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 120
          }
        },
        "tooltip": [
          {
            "field": "class",
            "type": "nominal",
            "title": "Animal Class"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Threatened Species"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 215,
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#e8e0d0"
      },
      "encoding": {
        "theta": {
          "field": "class",
          "type": "nominal",
          "sort": {
            "field": "species_count",
            "order": "descending"
          }
        },
        "text": {
          "field": "species_count",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "background": "#1a2a3a",
    "view": {
      "stroke": null
    }
  }
}