{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Threatened Species by Animal Class",
    "subtitle": "A simple ranking chart showing which animal groups have the most threatened species",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/threatened_species.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "distinct",
          "field": "common_name",
          "as": "species_count"
        }
      ],
      "groupby": ["class"]
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 4,
    "cornerRadiusTopRight": 4
  },
  "encoding": {
    "x": {
      "field": "class",
      "type": "nominal",
      "sort": {
        "field": "species_count",
        "order": "descending"
      },
      "title": "Animal Class",
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "species_count",
      "type": "quantitative",
      "title": "Number of Threatened Species",
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12",
        "gridColor": "#2c3e50"
      }
    },
    "color": {
      "field": "class",
      "type": "nominal",
      "legend": null,
      "scale": {
        "range": [
          "#c0392b",
          "#e67e22",
          "#f1c40f",
          "#2ecc71",
          "#8e44ad",
          "#3498db"
        ]
      }
    },
    "tooltip": [
      {
        "field": "class",
        "type": "nominal",
        "title": "Animal Class"
      },
      {
        "field": "species_count",
        "type": "quantitative",
        "title": "Threatened Species"
      }
    ]
  },
  "config": {
    "background": "#1a2a3a",
    "view": {
      "stroke": null
    }
  }
}