{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Wildlife Casualties: A Heatmap of Devastation",
    "subtitle": "Millions of animals killed by state and year — darker colours mean more deaths",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 350,
  "data": {"url": "data/bushfire.csv"},
  "mark": {
    "type": "rect",
    "stroke": "#0d1b2a",
    "strokeWidth": 2,
    "cornerRadius": 4
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12",
        "labelAngle": -45
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": "State / Territory",
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12"
      }
    },
    "color": {
      "field": "animals_killed_million",
      "type": "quantitative",
      "title": "Animals Killed (Millions)",
      "scale": {
        "scheme": "yelloworangered",
        "domain": [0, 1200]
      },
      "legend": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12",
        "orient": "right"
      }
    }

}