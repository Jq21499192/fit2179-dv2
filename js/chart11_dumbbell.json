{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Wildlife Casualties: 2009 vs 2019 by State",
    "subtitle": "Min vs Max animal deaths across all recorded bushfires",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 350,
  "data": { "url": "data/bushfire.csv" },
  "layer": [
    {
      "transform": [
        {
          "aggregate": [
            { "op": "min", "field": "animals_killed_million", "as": "min_val" },
            { "op": "max", "field": "animals_killed_million", "as": "max_val" }
          ],
          "groupby": ["state"]
        }
      ],
  
      "mark": { "type": "rule", "strokeWidth": 3, "color": "#bdc3c7", "opacity": 0.6 },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": { "labelColor": "#e8e0d0", "labelFontSize": 12 }
        },
        "x": {
          "field": "min_val",
          "type": "quantitative",
          "title": "Animals Killed (millions)",
          "axis": {
            "labelColor": "#bdc3c7",
            "titleColor": "#bdc3c7",
            "gridColor": "#2c3e50"
          }
        },
        "x2": { "field": "max_val" }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            { "op": "min", "field": "animals_killed_million", "as": "animals_killed_million" }
          ],
          "groupby": ["state"]
        }
      ],
      "mark": { "type": "point", "filled": true, "size": 100, "color": "#2980b9" },
      "encoding": {
        "y": { "field": "state", "type": "nominal", "sort": "-x" },
        "x": { "field": "animals_killed_million", "type": "quantitative" },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "animals_killed_million", "type": "quantitative", "title": "Min Killed (M)", "format": ".1f" }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            { "op": "max", "field": "animals_killed_million", "as": "animals_killed_million" }
          ],
          "groupby": ["state"]
        }
      ],
      "mark": { "type": "point", "filled": true, "size": 100, "color": "#c0392b" },
      "encoding": {
        "y": { "field": "state", "type": "nominal", "sort": "-x" },
        "x": { "field": "animals_killed_million", "type": "quantitative" },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "animals_killed_million", "type": "quantitative", "title": "Max Killed (M)", "format": ".1f" }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": { "stroke": "transparent" }
  }
}