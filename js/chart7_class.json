{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Threatened Species by Animal Class",
    "subtitle": "Which animal groups are most at risk?",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 380,
  "data": {"url": "data/threatened_species.csv"},
  "transform": [
  {
    "aggregate": [
      {
        "op": "count",
        "as": "species_count"
      }
    ],
    "groupby": ["class", "status"]
  },
  {
    "impute": "species_count",
    "key": "class",
    "groupby": ["status"],
    "value": 0
  }
],
  "mark": {
    "type": "circle",
    "opacity": 0.85,
    "stroke": "#0d1b2a",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "class",
      "type": "nominal",
      "title": "Animal Class",
      "sort": ["Mammalia", "Aves", "Reptilia", "Amphibia", "Actinopterygii"],
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12",
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "status",
      "type": "nominal",
      "title": "Conservation Status",
      "sort": ["Critically Endangered", "Endangered", "Vulnerable", "Near Threatened", "Extinct"],
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12"
      }
    },
    "size": {
  "condition": {
    "test": "datum.species_count == 0",
    "value": 80
  },
  "field": "species_count",
  "type": "quantitative",
  "title": "Number of Species",
  "scale": {
    "domain": [0, 14],
    "range": [80, 1800]
  },
  "legend": {
    "labelColor": "#e8e0d0",
    "titleColor": "#f39c12",
    "symbolFill": "#ffffff",
    "symbolStroke": "#e8e0d0",
    "symbolStrokeWidth": 1.5,
    "values": [0, 2, 4, 6, 8, 10, 12, 14]
  }
},
"color": {
  "condition": {
    "test": "datum.species_count == 0",
    "value": "#ffffff"
  },
  "field": "status",
  "type": "nominal",
  "scale": {
    "domain": [
      "Critically Endangered",
      "Endangered",
      "Vulnerable",
      "Near Threatened",
      "Extinct"
    ],
    "range": [
      "#c0392b",
      "#e67e22",
      "#f1c40f",
      "#2ecc71",
      "#8e44ad"
    ]
  },
  "legend": null
},
    "tooltip": [
      {"field": "class", "title": "Class"},
      {"field": "status", "title": "Status"},
      {"field": "count", "title": "Count"}
    ]
  },
  "config": {
    "background": "#1a2a3a",
    "view": {"stroke": null}
  }
  
}