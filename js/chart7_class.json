{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Threatened Species by Animal Class",
    "subtitle": "Which animal groups are most at risk?",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 380,
  "data": {"url": "data/threatened_species.csv"},
  "transform": [
    {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["class", "status"]}
  ],
  "mark": {
    "type": "circle",
    "opacity": 0.85,
    "stroke": "#0d1b2a",
    "strokeWidth": 1.5
  },
  "encoding": {
    "x": {
      "field": "class",
      "type": "nominal",
      "title": "Animal Class",
      "sort": ["Mammalia", "Aves", "Reptilia", "Amphibia", "Actinopterygii"],
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12",
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "status",
      "type": "nominal",
      "title": "Conservation Status",
      "sort": ["Critically Endangered", "Endangered", "Vulnerable", "Near Threatened", "Extinct"],
      "axis": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12"
      }
    },
    "size": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Species",
      "scale": {"range": [100, 2000]},
      "legend": {
        "labelColor": "#e8e0d0",
        "titleColor": "#f39c12"
      }
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": ["Critically Endangered", "Endangered", "Vulnerable", "Near Threatened", "Extinct"],
        "range": ["#c0392b", "#e67e22", "#f1c40f", "#2ecc71", "#8e44ad"]
      },
      "legend": null
    },
    "tooltip": [
      {"field": "class", "title": "Class"},
      {"field": "status", "title": "Status"},
      {"field": "count", "title": "Count"}
    ]
  },
  "config": {
    "background": "#1a2a3a",
    "view": {"stroke": null}
  }
  
}