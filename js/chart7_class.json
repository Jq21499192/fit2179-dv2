{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Threatened Species by Animal Class",
    "subtitle": "Which animal groups are most at risk?",
    "color": "#f39c12",
    "subtitleColor": "#bdc3c7",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 380,
  "data": {"url": "data/threatened_species.csv"},
  "transform": [
    {"aggregate": [{"op": "count", "as": "count"}], "groupby": ["class", "status"]}
  ],
  "mark": {
    "type": "circle",
    "opacity": 0.85,
    "stroke": "#0d1b2a",
    "strokeWidth": 1.5
  }
  
}