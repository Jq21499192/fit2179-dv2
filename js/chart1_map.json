{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title":{
        "text":"Distribution of Threatened Species Across Australia",
        "subtitle":"Each dot represents a species occurrence. Click  a status in the legend to filer.",
        "color":"#f39c12",
        "subtitleColor":"#bdc3c7",
        "fontSize":16,
        "subtitleFontSize":12
    },
    "width":"container",
    "height":520,
    "params": [
        {
            "name":"status_select",
            "select":{
                "type":"point",
                "fields":[
                    "status"
                ]
            },
            "bind":"legend"
        }
    ],
    "layer":[
        {
            "data":{
                "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
                "format":{
                    "type":"topojson",
                    "feature": "countries"
                }
            },
            "mark":{
                "type":"circle",
                "opacity":0.75,
                "size":55,
                "stroke":"white",
                "strokeWidth":0.3
            },
            "params":[
                {
                    "name":"status_select",
                    "select":{
                        "type":"point",
                        "field":[
                            "status"
                        ]
                    },
                    "bind":"legend"
                }
            ],
            "encoding":{
                "longitude":{
                    "field":"longitude",
                    "type":"quantitative"
                },
                "latitude":{
                    "field":"latitude",
                    "type":"nominal",

                },
                "color":{
                    "field":"status",
                    "type":"nominal",
                    "scale":{
                        "domain":[
                            "Critically Endangered",
                            "Endangered",
                            "Vulnerable",
                            "Near Threatened",
                            "Extinct"
                        ],
                        "range":[
                            "#c0392b"
                            "#e67e22"
                            "#f1c40f",
                            "#2ecc71",
                            "#8e44ad"

                        ]
                    },
                    "legend":{
                        "title":"Conservation Status",
                        "labelColor":"#e8e0d0",
                        "titleColor":"#f39c12"
                    }
                },
                "size":{
                    "field":"status",
                    "type":"nominal",
                    "scale":{
                        "domain":["Critically Endangered", "Endagered", "Vulnerable", "Near THreatened", "Extinct"],
                        "range":[120,80.60,50,100]
                    },
                    "legend": null
                },
                "opacity":{
                    "condition":{"param":"status_select", "value": 0.85},
                    "value":0.1
                },
                "tooltip":[
                    {"field":"common_name", "title":"Common Name"},
                    {"field":"species","title":"Scientific Name"},
                    {"field":"class","title":"Animal Class"},
                    {"field":"status","title":"Status"},
                    {"field":"state","title":"State"}
                ]
            }
        }
    ],
    "projection":{
        "type":"mercator",
        "center":[134, -28],
        "scale":750
    },
    "config":{
        "background":"#0d1b2a",
        "view":{"stroke": null}
    }
    
}
